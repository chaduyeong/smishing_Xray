# ==========================================================
# 이 파일을 복사해서 이름을 ".env"로 바꾸고 키를 넣으세요.
#   (팀원이 이미 쓰던 ".env.local"이 있으면 그 파일도 그대로 읽어요)
# .env / .env.local 은 GitHub에 올라가지 않아요 (.gitignore에 등록됨)
# 키가 없는 기능은 규칙 기반 분석으로 자동 대체되니, 일단 비워둬도 실행은 돼요.
# ==========================================================

# [AI] OpenRouter API 키 — X-ray 스캔·수법 DNA의 AI 분석 (https://openrouter.ai/keys)
OPENROUTER_API_KEY=여기에_키_붙여넣기

# [AI] 사용할 모델 — 두 기능이 같이 씀 (openrouter/free = 무료 모델 자동 선택, 이미지 분석 가능)
OPENROUTER_MODEL=openrouter/free

# [공공데이터] KISA 후이즈(WHOIS) 인증키 — X-ray의 .kr 도메인 등록 여부 조회 (data.go.kr)
KISA_KEY=

# [공공데이터] 행정안전부 기관코드 인증키 — X-ray의 사칭 기관 실존 여부 조회 (data.go.kr)
MOIS_KEY=
